# ============================================================
# Product Recommendation System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Kaggle API Credentials ---
# Required to download the primary dataset.
# Get from: https://www.kaggle.com/account → API → Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# --- Dataset Path Override (optional) ---
# Override the dataset path if your CSV is in a non-standard location.
# Leave blank to use the path from config.yaml (data/raw/amazon.csv).
DATA_RAW_FILEPATH=

# --- Application Settings ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# --- MLflow Settings ---
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=product-recommendation

# --- Database ---
DATABASE_URL=sqlite:///data/recommendation.db

# --- Logging ---
LOG_LEVEL=INFO

# --- Cache ---
CACHE_DEFAULT_TTL=3600

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

# --- Monitoring ---
MONITORING_ENABLED=true
